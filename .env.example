# ==============================================================================
# VeilPay — Environment Variables Template (.env.example)
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# Reown AppKit Project ID (from https://dashboard.reown.com)
NEXT_PUBLIC_PROJECT_ID=

# Etherscan V2 Multichain API Key (from https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=

# Google Gemini API Key (from https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Mainnet Safety Guardrail (Maximum allowed USD per cross-chain transaction during demos)
NEXT_PUBLIC_MAX_MAINNET_USD=5.00

# TigerGraph RESTPP & Savanna Credentials (optional, in-process GSQL engine runs if unset)
# TIGERGRAPH_HOST=
# TIGERGRAPH_GRAPH=VeilPayGraph
# TIGERGRAPH_SECRET=
# TIGERGRAPH_TOKEN=

# Socket Swap V3 Dedicated Backend Credentials (optional, public-backend works without key)
# SOCKET_API_KEY=
# SOCKET_AFFILIATE_ID=

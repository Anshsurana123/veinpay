# ==============================================================================
# VeinPay — Environment Variables Template (.env.example)
# Copy this file to .env.local and populate with your credentials.
# ==============================================================================

# Reown AppKit Project ID (from https://dashboard.reown.com)
# When missing, wallet connect is disabled with a visible reason.
NEXT_PUBLIC_PROJECT_ID=

# App Deployment URL (used for payment link sharing and metadata)
NEXT_PUBLIC_APP_URL=https://veinpay.vercel.app

# Demo Mode Toggle (set true only in local development to load fixture vault addresses)
NEXT_PUBLIC_DEMO_MODE=false
ALLOW_LOCAL_ENGINE=false
ALLOW_EPHEMERAL_STATE=false
VEINPAY_ALLOW_DEV_SECRETS=false

# Core Production Secrets (Mandatory in production; validated at boot in instrumentation.ts)
RECEIPT_SIGNING_KEY=
RECEIPT_ACTIVE_KEY_ID=veinpay-ed25519-v1
# RECEIPT_SIGNING_KEYS={"veinpay-ed25519-v1":"...","veinpay-ed25519-v2":"..."}
VEINPAY_SESSION_SECRET=
VEINPAY_ATTESTATION_SECRET=

# Upstash Redis REST Credentials (Required in production for serverless consistency)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Trusted Client IP Header (e.g. x-vercel-forwarded-for or cf-connecting-ip)
TRUSTED_IP_HEADER=x-vercel-forwarded-for

# Etherscan V2 Multichain API Key (from https://etherscan.io/myapikey)
ETHERSCAN_API_KEY=

# GoPlus Security API Key (from https://gopluslabs.io)
GOPLUS_API_KEY=

# Google Gemini API & Narration Gate
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_GEMINI_NARRATION=false

# TigerGraph 4.x RESTPP & Savanna Credentials
# Set TIGERGRAPH_REQUIRED=true in production to enforce live cluster verification
TIGERGRAPH_REQUIRED=false
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH=VeinPayGraph
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=
TIGERGRAPH_QUERY_TIMEOUT_MS=8000

# Model Context Protocol (MCP) Server Configuration
MCP_ENABLED=true
MCP_API_KEY=

# Socket Swap V3 Dedicated Backend Credentials (optional, public-backend works without key)
# SOCKET_API_KEY=
# SOCKET_AFFILIATE_ID=
SOCKET_TIMEOUT_MS=3500

# Server-Side Crawler Hard Limits (Clamps client-supplied settings)
MAX_CRAWL_TOP_FUNDERS=10
MAX_CRAWL_API_CALLS=50
MAX_CRAWL_RPS=5
MAX_CRAWL_TIMEOUT_MS=15000
MAX_MAINNET_USD_CAP=50

# Mainnet Safety Guardrail (Default USD cap per cross-chain transaction during demos)
NEXT_PUBLIC_MAX_MAINNET_USD=5.00
